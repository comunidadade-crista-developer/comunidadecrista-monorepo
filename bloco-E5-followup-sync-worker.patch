+const silent = { info: () => {}, warn: () => {} };
+
+async function waitFor(
+  check: () => Promise<boolean>,
+  timeoutMs = 3000,
+): Promise<void> {
+  const start = Date.now();
+  while (!(await check())) {
+    if (Date.now() - start > timeoutMs)
+      throw new Error("waitFor: tempo esgotado");
+    await new Promise((r) => setTimeout(r, 20));
+  }
+}
+
 describe("outbox worker", () => {
   it("evento sem handler fica concluído (a tabela não cresce)", async () => {
     const db = await getTestDb();
@@ -102,3 +117,69 @@ describe("outbox worker", () => {
     expect(backoffMs(50)).toBe(5 * 60_000);
   });
 });
+
+describe("outbox worker: concorrência e paragem", () => {
+  it("duas rondas em simultâneo nunca tratam o mesmo evento duas vezes", async () => {
+    const db = await getTestDb();
+    const ids: string[] = [];
+    for (let i = 0; i < 20; i++) ids.push((await enqueue("post.created")).id);
+
+    const handled: string[] = [];
+    const handlers = {
+      "post.created": async (ev: { id: string }) => {
+        handled.push(ev.id);
+        await new Promise((r) => setTimeout(r, 5));
+      },
+    };
+    const [a, b] = await Promise.all([
+      processOutboxBatch(db, { batchSize: 20, handlers }),
+      processOutboxBatch(db, { batchSize: 20, handlers }),
+    ]);
+
+    expect(a.claimed + b.claimed).toBe(20);
+    expect(handled).toHaveLength(20);
+    expect(new Set(handled).size).toBe(20);
+    expect([...handled].sort()).toEqual([...ids].sort());
+  });
+
+  it("startOutboxWorker processa eventos e stop() espera pela ronda em curso", async () => {
+    const db = await getTestDb();
+    const e = await enqueue("post.created");
+    let finished = false;
+    let started = false;
+
+    const stop = startOutboxWorker({
+      db,
+      log: silent,
+      intervalMs: 10,
+      batchSize: 10,
+      handlers: {
+        "post.created": async () => {
+          started = true;
+          await new Promise((r) => setTimeout(r, 150));
+          finished = true;
+        },
+      },
+    });
+
+    await waitFor(async () => started);
+    await stop(); // a meio do handler: tem de esperar
+    expect(finished).toBe(true);
+    expect((await statusOf(e.id)).status).toBe("done");
+  });
+
+  it("depois de stop() o worker já não consome eventos", async () => {
+    const db = await getTestDb();
+    const stop = startOutboxWorker({
+      db,
+      log: silent,
+      intervalMs: 10,
+      batchSize: 10,
+    });
+    await stop();
+
+    const e = await enqueue("post.liked");
+    await new Promise((r) => setTimeout(r, 150));
+    expect((await statusOf(e.id)).status).toBe("pending");
+  });
+});
diff --git a/apps/api/test/workers/server-worker.test.ts b/apps/api/test/workers/server-worker.test.ts
new file mode 100644
index 0000000..65ec73d
--- /dev/null
+++ b/apps/api/test/workers/server-worker.test.ts
@@ -0,0 +1,76 @@
+import { eq } from "drizzle-orm";
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { outbox } from "../../src/db/schema.js";
+import { loadEnv } from "../../src/env.js";
+import { outboxRepo } from "../../src/repositories/outbox.js";
+import { buildServer } from "../../src/server.js";
+import { closeTestDb, getTestDb, truncateAll } from "../helpers/db.js";
+
+const AGG = "0190a0a0-0000-7000-8000-000000000002";
+
+const baseEnv = {
+  NODE_ENV: "test",
+  LOG_LEVEL: "fatal",
+  APP_VERSION: "test",
+  OUTBOX_WORKER_INTERVAL_MS: 200,
+} as const;
+
+async function enqueue() {
+  const db = await getTestDb();
+  return outboxRepo(db).enqueue({
+    aggregateType: "post",
+    aggregateId: AGG,
+    eventType: "post.liked",
+    payload: { postId: AGG },
+  });
+}
+
+async function statusOf(id: string) {
+  const db = await getTestDb();
+  const [row] = await db.select().from(outbox).where(eq(outbox.id, id));
+  return row!.status;
+}
+
+beforeAll(async () => {
+  await getTestDb();
+});
+afterAll(async () => {
+  await closeTestDb();
+});
+beforeEach(async () => {
+  await truncateAll();
+});
+
+describe("buildServer: worker do outbox", () => {
+  it("em testes não arranca por omissão", async () => {
+    const app = await buildServer({ env: loadEnv(baseEnv) });
+    await app.ready();
+    const e = await enqueue();
+    await new Promise((r) => setTimeout(r, 700));
+    expect(await statusOf(e.id)).toBe("pending");
+    await app.close();
+  });
+
+  it("com disableWorker: false arranca em onReady e pára em close", async () => {
+    const app = await buildServer({
+      env: loadEnv(baseEnv),
+      disableWorker: false,
+    });
+    const e = await enqueue();
+    // Antes de `ready()` (onReady) nada corre.
+    await new Promise((r) => setTimeout(r, 450));
+    expect(await statusOf(e.id)).toBe("pending");
+
+    await app.ready();
+    const start = Date.now();
+    while ((await statusOf(e.id)) !== "done") {
+      if (Date.now() - start > 4000) throw new Error("worker não arrancou");
+      await new Promise((r) => setTimeout(r, 50));
+    }
+    await app.close();
+
+    const e2 = await enqueue();
+    await new Promise((r) => setTimeout(r, 450));
+    expect(await statusOf(e2.id)).toBe("pending");
+  });
+});
