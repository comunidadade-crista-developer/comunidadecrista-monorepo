# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=dev
CORS_ORIGIN=http://localhost:5173

# Base de dados (Neon em produção, docker-compose em dev)
DATABASE_URL=postgres://comunidade:comunidade_dev@localhost:5430/comunidade_dev

# Redis (Upstash em produção, docker-compose em dev)
REDIS_URL=redis://localhost:6379

# Proxy genérico (VPS, Fly...). Em dev local: false. Não usar com EDGE_MODE=cloudflare.
TRUST_PROXY=false
# Nº de proxies de confiança (só com TRUST_PROXY=true)
TRUST_PROXY_HOPS=1

# Cloudflare à frente da API (produção). Ver docs/runbooks/runbook.md.
# Em dev local deixa EDGE_MODE=none.
EDGE_MODE=none
# Segredos (>= 32 caracteres). Gerar com: openssl rand -base64 48
# CF_ORIGIN_SECRET=
# Só durante uma rotação do segredo:
# CF_ORIGIN_SECRET_PREVIOUS=

# HMAC que anonimiza IP/username nas chaves do rate limit. Obrigatório em produção.
# IP_HASH_SECRET=

# JWT (gerar com: pnpm --filter @comunidade/api generate-jwt-keys)
JWT_PRIVATE_JWK=
JWT_PUBLIC_JWK=
# Só durante uma rotação de chaves: a chave PÚBLICA antiga (nunca a privada).
# JWT_PUBLIC_JWK_PREVIOUS=
JWT_ISSUER=comunidade-crista
JWT_AUDIENCE=comunidade-crista-api

# Argon2
ARGON2_MEMORY_KB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_S=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_S=3600
RATE_LIMIT_RECOVER_MAX=5
RATE_LIMIT_RECOVER_WINDOW_S=3600
# Limites por IP (todas as contas) e por conta (todos os IPs)
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_IP_WINDOW_S=900
RATE_LIMIT_LOGIN_ACCOUNT_MAX=20
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_S=3600
RATE_LIMIT_RECOVER_IP_MAX=20
RATE_LIMIT_RECOVER_IP_WINDOW_S=3600
RATE_LIMIT_RECOVER_ACCOUNT_QUESTIONS_MAX=5
RATE_LIMIT_RECOVER_ACCOUNT_QUESTIONS_WINDOW_S=86400
RATE_LIMIT_RECOVER_ACCOUNT_CODE_MAX=10
RATE_LIMIT_RECOVER_ACCOUNT_CODE_WINDOW_S=3600

# Recuperação por perguntas de segurança só produz efeito após este atraso (horas)
RECOVERY_QUESTIONS_DELAY_HOURS=24
# Pool do Postgres (DB_QUERY_TIMEOUT_MS=0 desactiva o limite do cliente)
DB_POOL_MAX=10
DB_QUERY_TIMEOUT_MS=15000

# Apagamento de conta: dias entre o pedido e a eliminação definitiva (login reactiva)
ACCOUNT_DELETION_GRACE_DAYS=30
# Limpeza periódica (purga de contas e de dados com prazo), em minutos
MAINTENANCE_INTERVAL_MINUTES=60
 