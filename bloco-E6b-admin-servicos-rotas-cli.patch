+++ b/apps/api/src/routes/admin.ts
@@ -0,0 +1,199 @@
+import {
+  AdminApproveRequest,
+  AdminListPostsQuery,
+  AdminListPostsResponse,
+  AdminListReportsQuery,
+  AdminModerationLogQuery,
+  AdminModerationLogResponse,
+  AdminModerationResponse,
+  AdminPostDetailResponse,
+  AdminRejectRequest,
+  AdminReportListResponse,
+  ErrorResponse,
+  PostIdParams,
+} from "@comunidade/shared";
+import type { FastifyInstance, FastifyReply } from "fastify";
+import type { ZodTypeProvider } from "fastify-type-provider-zod";
+import type { JwtService } from "../auth/jwt.js";
+import { requireAdmin, requireAuth } from "../auth/middleware.js";
+import type { RateLimitResult, RateLimiters } from "../auth/rate-limit.js";
+import type { FeedCache } from "../cache/feed-cache.js";
+import type { Database } from "../db/client.js";
+import {
+  approvePost,
+  getAdminPostDetail,
+  listAdminModerationLog,
+  listAdminPosts,
+  listAdminReports,
+  rejectPost,
+  type AdminServiceError,
+} from "../services/admin.js";
+
+export interface AdminRoutesOptions {
+  db: Database;
+  jwt: JwtService;
+  limiters: RateLimiters;
+  feedCache: FeedCache;
+}
+
+/** Erro no formato único `{ error }` (o `ErrorResponse` de cada rota já o declara). */
+function sendError(
+  reply: object,
+  status: number,
+  error: string,
+  retryAfter?: number,
+): FastifyReply {
+  const r = (reply as FastifyReply).code(status);
+  if (retryAfter !== undefined) r.header("Retry-After", String(retryAfter));
+  return r.send({ error });
+}
+
+function tooMany(reply: object, rl: RateLimitResult): FastifyReply {
+  return sendError(reply, 429, "rate_limited", rl.retryAfter ?? 60);
+}
+
+function sendServiceError(reply: object, e: AdminServiceError): FastifyReply {
+  return sendError(reply, e.status, e.code);
+}
+
+const ReadErrors = {
+  400: ErrorResponse,
+  401: ErrorResponse,
+  403: ErrorResponse,
+  429: ErrorResponse,
+} as const;
+
+const DecisionErrors = {
+  ...ReadErrors,
+  404: ErrorResponse,
+  409: ErrorResponse,
+} as const;
+
+/**
+ * Painel de administração (ADR-015). Todas as rotas exigem sessão válida E papel de admin
+ * revalidado na base de dados, em `preValidation`: sem isso o pedido é recusado (401/403)
+ * antes de se olhar para o corpo ou a query, e quem não é admin não aprende nada sobre o
+ * formato dos pedidos.
+ */
+export async function adminRoutes(
+  app: FastifyInstance,
+  { db, jwt, limiters, feedCache }: AdminRoutesOptions,
+): Promise<void> {
+  const f = app.withTypeProvider<ZodTypeProvider>();
+  const adminPre = [requireAuth(jwt), requireAdmin(db)];
+
+  f.get(
+    "/admin/posts",
+    {
+      preValidation: adminPre,
+      schema: {
+        querystring: AdminListPostsQuery,
+        response: { 200: AdminListPostsResponse, ...ReadErrors },
+      },
+    },
+    async (request, reply) => {
+      const rl = await limiters.checkAdminRead(request.user!.id);
+      if (!rl.allowed) return tooMany(reply, rl);
+      const r = await listAdminPosts(db, request.query);
+      if (!r.ok) return sendServiceError(reply, r.error);
+      return reply.code(200).send(r.data);
+    },
+  );
+
+  f.get(
+    "/admin/posts/:id",
+    {
+      preValidation: adminPre,
+      schema: {
+        params: PostIdParams,
+        response: { 200: AdminPostDetailResponse, ...DecisionErrors },
+      },
+    },
+    async (request, reply) => {
+      const rl = await limiters.checkAdminRead(request.user!.id);
+      if (!rl.allowed) return tooMany(reply, rl);
+      const r = await getAdminPostDetail(db, request.params.id);
+      if (!r.ok) return sendServiceError(reply, r.error);
+      return reply.code(200).send(r.data);
+    },
+  );
+
+  f.post(
+    "/admin/posts/:id/approve",
+    {
+      preValidation: adminPre,
+      schema: {
+        params: PostIdParams,
+        body: AdminApproveRequest,
+        response: { 200: AdminModerationResponse, ...DecisionErrors },
+      },
+    },
+    async (request, reply) => {
+      const adminId = request.user!.id;
+      const rl = await limiters.checkAdminWrite(adminId);
+      if (!rl.allowed) return tooMany(reply, rl);
+      const r = await approvePost(db, adminId, request.params.id, request.body);
+      if (!r.ok) return sendServiceError(reply, r.error);
+      // Só a aprovação muda o que o feed público mostra (passa a haver um post novo).
+      await feedCache.invalidate();
+      return reply.code(200).send(r.data);
+    },
+  );
+
+  f.post(
+    "/admin/posts/:id/reject",
+    {
+      preValidation: adminPre,
+      schema: {
+        params: PostIdParams,
+        body: AdminRejectRequest,
+        response: { 200: AdminModerationResponse, ...DecisionErrors },
+      },
+    },
+    async (request, reply) => {
+      const adminId = request.user!.id;
+      const rl = await limiters.checkAdminWrite(adminId);
+      if (!rl.allowed) return tooMany(reply, rl);
+      const r = await rejectPost(db, adminId, request.params.id, request.body);
+      if (!r.ok) return sendServiceError(reply, r.error);
+      // Um post em revisão nunca esteve no feed público: não há nada a invalidar.
+      return reply.code(200).send(r.data);
+    },
+  );
+
+  f.get(
+    "/admin/reports",
+    {
+      preValidation: adminPre,
+      schema: {
+        querystring: AdminListReportsQuery,
+        response: { 200: AdminReportListResponse, ...ReadErrors },
+      },
+    },
+    async (request, reply) => {
+      const rl = await limiters.checkAdminRead(request.user!.id);
+      if (!rl.allowed) return tooMany(reply, rl);
+      const r = await listAdminReports(db, request.query);
+      if (!r.ok) return sendServiceError(reply, r.error);
+      return reply.code(200).send(r.data);
+    },
+  );
+
+  f.get(
+    "/admin/moderation-log",
+    {
+      preValidation: adminPre,
+      schema: {
+        querystring: AdminModerationLogQuery,
+        response: { 200: AdminModerationLogResponse, ...ReadErrors },
+      },
+    },
+    async (request, reply) => {
+      const rl = await limiters.checkAdminRead(request.user!.id);
+      if (!rl.allowed) return tooMany(reply, rl);
+      const r = await listAdminModerationLog(db, request.query);
+      if (!r.ok) return sendServiceError(reply, r.error);
+      return reply.code(200).send(r.data);
+    },
+  );
+}
diff --git a/apps/api/src/services/admin-roles.ts b/apps/api/src/services/admin-roles.ts
new file mode 100644
index 0000000..3d33445
--- /dev/null
+++ b/apps/api/src/services/admin-roles.ts
@@ -0,0 +1,142 @@
+import { and, count, eq, isNull, ne } from "drizzle-orm";
+import type { Database, DbTransaction } from "../db/client.js";
+import { refreshTokens, users } from "../db/schema.js";
+import type { User } from "../db/schema.js";
+import { lockAdminRoster } from "../repositories/admin-roster.js";
+import { moderationLogRepo } from "../repositories/reports.js";
+
+/**
+ * Promoção e despromoção de administradores (ADR-015). Só são chamadas pelos scripts
+ * `admin:promote` e `admin:demote`: nenhuma rota HTTP eleva privilégio.
+ */
+
+export type RoleChangeOutcome =
+  | "promoted"
+  | "already_admin"
+  | "demoted"
+  | "already_user";
+
+export type RoleChangeError =
+  /** O utilizador não existe. */
+  | { code: "not_found" }
+  /** Conta apagada ou em apagamento: não se promove (nem se mexe nela). */
+  | { code: "inactive" }
+  /** Despromover deixaria a plataforma sem nenhum admin activo. */
+  | { code: "last_admin" };
+
+export type RoleChangeResult =
+  | { ok: true; data: { outcome: RoleChangeOutcome; userId: string } }
+  | { ok: false; error: RoleChangeError };
+
+const fail = (error: RoleChangeError): RoleChangeResult => ({
+  ok: false,
+  error,
+});
+
+function isActive(u: Pick<User, "deletedAt" | "deletionRequestedAt">): boolean {
+  return !u.deletedAt && !u.deletionRequestedAt;
+}
+
+/** Linha do utilizador bloqueada até ao fim da transacção (nome insensível a maiúsculas). */
+async function lockUserByUsername(
+  tx: DbTransaction,
+  username: string,
+): Promise<User | null> {
+  const [row] = await tx
+    .select()
+    .from(users)
+    .where(and(eq(users.username, username), isNull(users.deletedAt)))
+    .for("update")
+    .limit(1);
+  return row ?? null;
+}
+
+/** Um papel novo invalida as sessões: o novo login traz o papel certo. */
+async function revokeSessions(tx: DbTransaction, userId: string) {
+  await tx
+    .update(refreshTokens)
+    .set({ revokedAt: new Date() })
+    .where(
+      and(eq(refreshTokens.userId, userId), isNull(refreshTokens.revokedAt)),
+    );
+}
+
+export async function promoteAdmin(
+  db: Database,
+  username: string,
+): Promise<RoleChangeResult> {
+  return db.transaction(async (tx) => {
+    const user = await lockUserByUsername(tx, username);
+    if (!user) return fail({ code: "not_found" });
+    if (!isActive(user)) return fail({ code: "inactive" });
+    if (user.role === "admin") {
+      return {
+        ok: true,
+        data: { outcome: "already_admin", userId: user.id },
+      } as const;
+    }
+
+    await tx.update(users).set({ role: "admin" }).where(eq(users.id, user.id));
+    await revokeSessions(tx, user.id);
+    await moderationLogRepo(tx).create({
+      action: "admin.promoted",
+      moderatorId: null,
+      targetUserId: user.id,
+      postId: null,
+      reason: null,
+    });
+    return {
+      ok: true,
+      data: { outcome: "promoted", userId: user.id },
+    } as const;
+  });
+}
+
+export async function demoteAdmin(
+  db: Database,
+  username: string,
+): Promise<RoleChangeResult> {
+  return db.transaction(async (tx) => {
+    const user = await lockUserByUsername(tx, username);
+    if (!user) return fail({ code: "not_found" });
+    if (user.role !== "admin") {
+      return {
+        ok: true,
+        data: { outcome: "already_user", userId: user.id },
+      } as const;
+    }
+
+    // Ordem de bloqueios: linha do utilizador, depois o bloqueio do conjunto de admins (igual
+    // ao do apagamento de conta, ver `lockAdminRoster`). Dois `demote` em simultâneo, ou um
+    // `demote` e um apagamento, ficam em série e o segundo vê o resultado do primeiro.
+    await lockAdminRoster(tx);
+    if (isActive(user)) {
+      const [others] = await tx
+        .select({ c: count() })
+        .from(users)
+        .where(
+          and(
+            eq(users.role, "admin"),
+            ne(users.id, user.id),
+            isNull(users.deletionRequestedAt),
+            isNull(users.deletedAt),
+          ),
+        );
+      if (Number(others?.c ?? 0) === 0) return fail({ code: "last_admin" });
+    }
+
+    await tx.update(users).set({ role: "user" }).where(eq(users.id, user.id));
+    await revokeSessions(tx, user.id);
+    await moderationLogRepo(tx).create({
+      action: "admin.demoted",
+      moderatorId: null,
+      targetUserId: user.id,
+      postId: null,
+      reason: null,
+    });
+    return {
+      ok: true,
+      data: { outcome: "demoted", userId: user.id },
+    } as const;
+  });
+}
diff --git a/apps/api/src/services/admin.ts b/apps/api/src/services/admin.ts
new file mode 100644
index 0000000..bae248e
--- /dev/null
+++ b/apps/api/src/services/admin.ts
@@ -0,0 +1,333 @@
+import type {
+  AdminListPostsQuery,
+  AdminListPostsResponse,
+  AdminListReportsQuery,
+  AdminModerationLogQuery,
+  AdminModerationLogResponse,
+  AdminModerationResponse,
+  AdminPostDetailResponse,
+  AdminReportListResponse,
+  AdminReportsByCategory,
+} from "@comunidade/shared";
+import { ADMIN_EXCERPT_MAX } from "@comunidade/shared";
+import type { Executor } from "../db/client.js";
+import type { ModerationLogEntry, Report, User } from "../db/schema.js";
+import { adminRepo, EMPTY_REPORTS_BY_CATEGORY } from "../repositories/admin.js";
+import { cardsRepo } from "../repositories/cards.js";
+import { outboxRepo } from "../repositories/outbox.js";
+import { InvalidCursorError, postsRepo } from "../repositories/posts.js";
+import { moderationLogRepo, reportsRepo } from "../repositories/reports.js";
+import { usersRepo } from "../repositories/users.js";
+
+export type AdminServiceError =
+  | { code: "not_found"; status: 404 }
+  /** Só se decide sobre posts em `pending_review`. */
+  | { code: "invalid_state"; status: 409 }
+  | { code: "invalid_cursor"; status: 400 };
+
+export type AdminResult<T> =
+  | { ok: true; data: T }
+  | { ok: false; error: AdminServiceError };
+
+const ok = <T>(data: T): AdminResult<T> => ({ ok: true, data });
+const fail = (error: AdminServiceError): AdminResult<never> => ({
+  ok: false,
+  error,
+});
+
+type Username = { username: string } | null;
+
+/** Contas removidas (ou inexistentes) aparecem como `null` («[removido]»). */
+function usernameOf(user: User | undefined): Username {
+  return user && !user.deletedAt ? { username: user.username } : null;
+}
+
+async function usersById(
+  db: Executor,
+  ids: (string | null)[],
+): Promise<Map<string, User>> {
+  const unique = Array.from(
+    new Set(ids.filter((id): id is string => id !== null)),
+  );
+  const rows = await usersRepo(db).findManyByIds(unique);
+  return new Map(rows.map((u) => [u.id, u]));
+}
+
+/** Excerto sem cortar um par substituto (emoji) ao meio. */
+function excerpt(content: string): string {
+  const chars = Array.from(content);
+  if (chars.length <= ADMIN_EXCERPT_MAX) return content;
+  return `${chars.slice(0, ADMIN_EXCERPT_MAX).join("").trimEnd()}…`;
+}
+
+function sumReports(by: AdminReportsByCategory): number {
+  return by.spam + by.off_topic + by.offensive + by.doctrine + by.other;
+}
+
+function reportItem(
+  r: Report,
+  titles: Map<string, string>,
+  users: Map<string, User>,
+) {
+  return {
+    id: r.id,
+    postId: r.postId,
+    postTitle: titles.get(r.postId) ?? null,
+    reporter: usernameOf(users.get(r.reporterId)),
+    category: r.category,
+    severity: r.severity,
+    reason: r.reason,
+    status: r.status,
+    createdAt: r.createdAt.toISOString(),
+    resolvedAt: r.resolvedAt ? r.resolvedAt.toISOString() : null,
+  };
+}
+
+function logItem(
+  e: ModerationLogEntry,
+  titles: Map<string, string>,
+  users: Map<string, User>,
+) {
+  return {
+    id: e.id,
+    action: e.action,
+    postId: e.postId,
+    postTitle: e.postId ? (titles.get(e.postId) ?? null) : null,
+    moderator: e.moderatorId ? usernameOf(users.get(e.moderatorId)) : null,
+    target: e.targetUserId ? usernameOf(users.get(e.targetUserId)) : null,
+    reason: e.reason,
+    createdAt: e.createdAt.toISOString(),
+  };
+}
+
+// ---------- Posts ----------
+
+export async function listAdminPosts(
+  db: Executor,
+  query: AdminListPostsQuery,
+): Promise<AdminResult<AdminListPostsResponse>> {
+  try {
+    const page = await adminRepo(db).listPostsPage({
+      status: query.status,
+      cursor: query.cursor,
+      limit: query.limit,
+    });
+    const [counts, users] = await Promise.all([
+      adminRepo(db).openReportsByPosts(page.items.map((p) => p.id)),
+      usersById(
+        db,
+        page.items.map((p) => p.authorId),
+      ),
+    ]);
+    return ok({
+      posts: page.items.map((p) => {
+        const by = counts.get(p.id) ?? { ...EMPTY_REPORTS_BY_CATEGORY };
+        return {
+          id: p.id,
+          category: p.category,
+          title: p.title,
+          excerpt: excerpt(p.content),
+          status: p.status,
+          author: p.authorId ? usernameOf(users.get(p.authorId)) : null,
+          reviewFlags: p.reviewFlags ?? [],
+          reportsCount: sumReports(by),
+          reportsByCategory: by,
+          createdAt: p.createdAt.toISOString(),
+        };
+      }),
+      nextCursor: page.nextCursor,
+    });
+  } catch (err) {
+    if (err instanceof InvalidCursorError) {
+      return fail({ code: "invalid_cursor", status: 400 });
+    }
+    throw err;
+  }
+}
+
+export async function getAdminPostDetail(
+  db: Executor,
+  postId: string,
+): Promise<AdminResult<AdminPostDetailResponse>> {
+  const repo = adminRepo(db);
+  const post = await repo.findPost(postId);
+  if (!post) return fail({ code: "not_found", status: 404 });
+
+  const [reportRows, logRows, counts, cards] = await Promise.all([
+    repo.reportsForPost(postId),
+    repo.logForPost(postId),
+    repo.openReportsByPosts([postId]),
+    post.gospelCardId
+      ? cardsRepo(db).findByIds([post.gospelCardId])
+      : Promise.resolve([]),
+  ]);
+  const users = await usersById(db, [
+    post.authorId,
+    ...reportRows.map((r) => r.reporterId),
+    ...logRows.map((e) => e.moderatorId),
+  ]);
+  const titles = new Map([[post.id, post.title]]);
+  const by = counts.get(postId) ?? { ...EMPTY_REPORTS_BY_CATEGORY };
+
+  return ok({
+    post: {
+      id: post.id,
+      category: post.category,
+      title: post.title,
+      content: post.content,
+      status: post.status,
+      author: post.authorId ? usernameOf(users.get(post.authorId)) : null,
+      gospelCardSlug: cards[0]?.slug ?? null,
+      reviewFlags: post.reviewFlags ?? [],
+      likesCount: post.likesCount,
+      reportsCount: sumReports(by),
+      reportsByCategory: by,
+      createdAt: post.createdAt.toISOString(),
+      publishedAt: post.publishedAt ? post.publishedAt.toISOString() : null,
+    },
+    reports: reportRows.map((r) => reportItem(r, titles, users)),
+    moderation: logRows.map((e) => logItem(e, titles, users)),
+  });
+}
+
+// ---------- Decisões ----------
+
+type Decision = "approve" | "reject";
+
+/**
+ * Decide um post em revisão. Tudo numa transacção: bloqueio da linha, mudança de estado,
+ * resolução das denúncias abertas, registo de auditoria e evento no outbox. Só se decide
+ * sobre `pending_review`: um post `hidden` (suspenso por apagamento de conta) ou já decidido
+ * dá `invalid_state`, para uma decisão não ressuscitar o que outra regra escondeu.
+ */
+async function decide(
+  db: Executor,
+  adminId: string,
+  postId: string,
+  decision: Decision,
+  text: string | undefined,
+): Promise<AdminResult<AdminModerationResponse>> {
+  return db.transaction(async (tx) => {
+    const locked = await adminRepo(tx).lockPostForDecision(postId);
+    if (!locked) return fail({ code: "not_found", status: 404 });
+    if (locked.status !== "pending_review") {
+      return fail({ code: "invalid_state", status: 409 });
+    }
+
+    const approve = decision === "approve";
+    const updated = await postsRepo(tx).setStatus(
+      postId,
+      approve ? "published" : "rejected",
+    );
+    if (!updated) return fail({ code: "not_found", status: 404 });
+
+    await reportsRepo(tx).resolveAllForPost(
+      postId,
+      approve ? "resolved_kept" : "resolved_removed",
+      adminId,
+    );
+    await moderationLogRepo(tx).create({
+      postId,
+      moderatorId: adminId,
+      action: approve ? "approved" : "rejected",
+      reason: text ?? null,
+    });
+    await outboxRepo(tx).enqueue({
+      aggregateType: "post",
+      aggregateId: postId,
+      eventType: approve ? "post.approved" : "post.rejected",
+      payload: { postId },
+    });
+
+    return ok({
+      post: {
+        id: updated.id,
+        status: updated.status,
+        publishedAt: updated.publishedAt
+          ? updated.publishedAt.toISOString()
+          : null,
+      },
+    });
+  });
+}
+
+export function approvePost(
+  db: Executor,
+  adminId: string,
+  postId: string,
+  body: { note?: string | undefined },
+): Promise<AdminResult<AdminModerationResponse>> {
+  return decide(db, adminId, postId, "approve", body.note);
+}
+
+export function rejectPost(
+  db: Executor,
+  adminId: string,
+  postId: string,
+  body: { reason: string },
+): Promise<AdminResult<AdminModerationResponse>> {
+  return decide(db, adminId, postId, "reject", body.reason);
+}
+
+// ---------- Denúncias e auditoria ----------
+
+export async function listAdminReports(
+  db: Executor,
+  query: AdminListReportsQuery,
+): Promise<AdminResult<AdminReportListResponse>> {
+  try {
+    const page = await adminRepo(db).listReportsPage({
+      status: query.status,
+      cursor: query.cursor,
+      limit: query.limit,
+    });
+    const [titles, users] = await Promise.all([
+      adminRepo(db).titlesByIds(page.items.map((r) => r.postId)),
+      usersById(
+        db,
+        page.items.map((r) => r.reporterId),
+      ),
+    ]);
+    return ok({
+      reports: page.items.map((r) => reportItem(r, titles, users)),
+      nextCursor: page.nextCursor,
+    });
+  } catch (err) {
+    if (err instanceof InvalidCursorError) {
+      return fail({ code: "invalid_cursor", status: 400 });
+    }
+    throw err;
+  }
+}
+
+export async function listAdminModerationLog(
+  db: Executor,
+  query: AdminModerationLogQuery,
+): Promise<AdminResult<AdminModerationLogResponse>> {
+  try {
+    const page = await adminRepo(db).listLogPage({
+      action: query.action,
+      postId: query.postId,
+      cursor: query.cursor,
+      limit: query.limit,
+    });
+    const [titles, users] = await Promise.all([
+      adminRepo(db).titlesByIds(
+        page.items.map((e) => e.postId).filter((id): id is string => !!id),
+      ),
+      usersById(db, [
+        ...page.items.map((e) => e.moderatorId),
+        ...page.items.map((e) => e.targetUserId),
+      ]),
+    ]);
+    return ok({
+      entries: page.items.map((e) => logItem(e, titles, users)),
+      nextCursor: page.nextCursor,
+    });
+  } catch (err) {
+    if (err instanceof InvalidCursorError) {
+      return fail({ code: "invalid_cursor", status: 400 });
+    }
+    throw err;
+  }
+}
