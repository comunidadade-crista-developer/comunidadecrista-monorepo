diff --git a/apps/api/test/helpers/factories.ts b/apps/api/test/helpers/factories.ts
index 9525068..d3684d2 100644
--- a/apps/api/test/helpers/factories.ts
+++ b/apps/api/test/helpers/factories.ts
@@ -1,5 +1,13 @@
 import { uuidv7 } from "uuidv7";
-import type { NewPost, NewUser, Post, User } from "../../src/db/schema.js";
+import { eq, sql } from "drizzle-orm";
+import { posts, reports } from "../../src/db/schema.js";
