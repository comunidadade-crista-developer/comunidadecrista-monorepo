diff --git a/apps/api/src/maintenance.ts b/apps/api/src/maintenance.ts
new file mode 100644
index 0000000..8b3d4c6
--- /dev/null
+++ b/apps/api/src/maintenance.ts
@@ -0,0 +1,106 @@
+import type { Database } from "./db/client.js";
+import type { Env } from "./env.js";
+import { accountDeletionRepo } from "./repositories/account-deletion.js";
+import {
+  idempotencyKeysRepo,
+  outboxRepo,
+} from "./repositories/outbox.js";
+import { refreshTokensRepo } from "./repositories/users.js";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+// Eventos concluídos e chaves de idempotência ficam este tempo para diagnóstico.
+const OUTBOX_DONE_RETENTION_DAYS = 7;
+const STARTUP_DELAY_MS = 30_000;
+
+export interface MaintenanceSummary {
+  idempotencyKeys: number;
+  outboxDone: number;
+  refreshTokens: number;
+  accounts: number;
+  postsDeleted: number;
+  failedAccounts: number;
+}
+
+export interface MaintenanceLogger {
+  info(obj: Record<string, unknown>, msg: string): void;
+  warn(obj: Record<string, unknown>, msg: string): void;
+}
+
+/**
+ * Limpeza periódica: dados com prazo (idempotência, outbox concluído, refresh tokens
+ * expirados) e contas cujo período de apagamento terminou. Cada passo é idempotente, por
+ * isso correr em duas instâncias ao mesmo tempo só duplica trabalho, nunca dados.
+ */
+export async function runMaintenance(
+  db: Database,
+  opts: { now?: Date; accountGraceDays: number; accountBatch?: number },
+): Promise<MaintenanceSummary> {
+  const now = opts.now ?? new Date();
+
+  const idempotency = await idempotencyKeysRepo(db).purgeExpired(now);
+  const outboxDone = await outboxRepo(db).purgeDone(
+    new Date(now.getTime() - OUTBOX_DONE_RETENTION_DAYS * DAY_MS),
+  );
+  const tokens = await refreshTokensRepo(db).purgeExpired(
+    new Date(now.getTime() - DAY_MS),
+  );
+  const accounts = await accountDeletionRepo(db).purgeDue({
+    now,
+    graceDays: opts.accountGraceDays,
+    ...(opts.accountBatch !== undefined ? { batch: opts.accountBatch } : {}),
+  });
+
+  return {
+    idempotencyKeys: idempotency,
+    outboxDone,
+    refreshTokens: tokens,
+    accounts: accounts.accounts,
+    postsDeleted: accounts.postsDeleted,
+    failedAccounts: accounts.failed,
+  };
+}
+
+/**
+ * Agenda `runMaintenance` dentro do processo (ADR-005: sem worker pago). Dorme com o
+ * serviço: corre no próximo arranque. Devolve a função que o pára.
+ */
+export function startMaintenance(args: {
+  db: Database;
+  env: Pick<Env, "ACCOUNT_DELETION_GRACE_DAYS" | "MAINTENANCE_INTERVAL_MINUTES">;
+  log: MaintenanceLogger;
+}): () => void {
+  const { db, env, log } = args;
+  let running = false;
+
+  const tick = async () => {
+    if (running) return;
+    running = true;
+    try {
+      const summary = await runMaintenance(db, {
+        accountGraceDays: env.ACCOUNT_DELETION_GRACE_DAYS,
+      });
+      log.info({ ...summary }, "maintenance done");
+    } catch (err) {
+      // Sem a mensagem: pode trazer dados.
+      log.warn(
+        { errorName: err instanceof Error ? err.name : typeof err },
+        "maintenance failed",
+      );
+    } finally {
+      running = false;
+    }
+  };
+
+  const first = setTimeout(() => void tick(), STARTUP_DELAY_MS);
+  const timer = setInterval(
+    () => void tick(),
+    env.MAINTENANCE_INTERVAL_MINUTES * 60_000,
+  );
+  first.unref();
+  timer.unref();
+
+  return () => {
+    clearTimeout(first);
+    clearInterval(timer);
+  };
+}
diff --git a/apps/api/src/repositories/account-deletion.ts b/apps/api/src/repositories/account-deletion.ts
new file mode 100644
index 0000000..2bda660
--- /dev/null
+++ b/apps/api/src/repositories/account-deletion.ts
@@ -0,0 +1,287 @@
+import { and, count, eq, isNotNull, isNull, lte, ne, sql } from "drizzle-orm";
+import type { Database } from "../db/client.js";
+import {
+  outbox,
+  pendingPasswordResets,
+  posts,
+  refreshTokens,
+  users,
+} from "../db/schema.js";
+
+type Tx = Parameters<Parameters<Database["transaction"]>[0]>[0];
+
+export type DeletionPostsMode = "anonymize" | "delete";
+
+export const ACCOUNT_DELETION_GRACE_DAYS = 30;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export type RequestDeletionResult =
+  | { outcome: "requested"; purgeAt: Date }
+  /** Já estava pendente: devolve o prazo original, não muda nada. */
+  | { outcome: "already_pending"; purgeAt: Date }
+  /** É o último administrador activo: sem ele a plataforma ficava sem moderação. */
+  | { outcome: "last_admin" }
+  | { outcome: "not_found" };
+
+export type RestoreResult = "restored" | "already_active" | "gone";
+
+export interface PurgeSummary {
+  accounts: number;
+  postsDeleted: number;
+  failed: number;
+}
+
+/** Autor a mostrar: nulo quando a conta foi removida ou está em apagamento com «anónimas». */
+export function publicAuthorId(post: {
+  authorId: string | null;
+  authorHidden: boolean;
+}): string | null {
+  return post.authorHidden ? null : post.authorId;
+}
+
+function addDays(date: Date, days: number): Date {
+  return new Date(date.getTime() + days * DAY_MS);
+}
+
+/**
+ * Apagamento de conta em duas fases (como o Facebook):
+ *  1. `request`: a conta fica pendente durante `graceDays`. Sem sessões e sem acesso, mas o
+ *     nome de utilizador continua reservado e um login com a palavra-passe correcta
+ *     reactiva-a (`restore`). As partilhas ficam anónimas ou ocultas, conforme a escolha.
+ *  2. `purgeDue`: passado o prazo, apaga a conta de vez.
+ */
+export function accountDeletionRepo(db: Database) {
+  return {
+    async request(args: {
+      userId: string;
+      postsMode: DeletionPostsMode;
+      graceDays?: number;
+    }): Promise<RequestDeletionResult> {
+      const graceDays = args.graceDays ?? ACCOUNT_DELETION_GRACE_DAYS;
+
+      return db.transaction(async (tx) => {
+        const [user] = await tx
+          .select({
+            role: users.role,
+            deletionRequestedAt: users.deletionRequestedAt,
+            deletedAt: users.deletedAt,
+          })
+          .from(users)
+          .where(eq(users.id, args.userId))
+          .for("update")
+          .limit(1);
+        if (!user || user.deletedAt) return { outcome: "not_found" as const };
+        if (user.deletionRequestedAt) {
+          return {
+            outcome: "already_pending" as const,
+            purgeAt: addDays(user.deletionRequestedAt, graceDays),
+          };
+        }
+
+        if (user.role === "admin") {
+          // Serializa pedidos de administradores: sem isto, dois admins a apagar-se ao mesmo
+          // tempo veriam cada um o outro como «activo» e a plataforma ficava sem admin.
+          await tx.execute(
+            sql`SELECT pg_advisory_xact_lock(hashtext('account-deletion:admin'))`,
+          );
+          const [others] = await tx
+            .select({ c: count() })
+            .from(users)
+            .where(
+              and(
+                eq(users.role, "admin"),
+                ne(users.id, args.userId),
+                isNull(users.deletionRequestedAt),
+                isNull(users.deletedAt),
+              ),
+            );
+          if (Number(others?.c ?? 0) === 0) {
+            return { outcome: "last_admin" as const };
+          }
+        }
+
+        const now = new Date();
+        await tx
+          .update(users)
+          .set({
+            deletionRequestedAt: now,
+            deletionPostsMode: args.postsMode,
+            updatedAt: now,
+          })
+          .where(eq(users.id, args.userId));
+        await tx
+          .update(refreshTokens)
+          .set({ revokedAt: now })
+          .where(
+            and(
+              eq(refreshTokens.userId, args.userId),
+              isNull(refreshTokens.revokedAt),
+            ),
+          );
+        await tx
+          .delete(pendingPasswordResets)
+          .where(eq(pendingPasswordResets.userId, args.userId));
+
+        if (args.postsMode === "delete") {
+          // Oculta guardando o estado anterior, para a reactivação o repor. Posts que já
+          // estavam ocultos (ex.: por um admin) não se tocam.
+          await tx
+            .update(posts)
+            .set({ suspendedStatus: sql`${posts.status}`, status: "hidden" })
+            .where(
+              and(eq(posts.authorId, args.userId), ne(posts.status, "hidden")),
+            );
+        } else {
+          await tx
+            .update(posts)
+            .set({ authorHidden: true })
+            .where(eq(posts.authorId, args.userId));
+        }
+
+        await tx.insert(outbox).values({
+          aggregateType: "user",
+          aggregateId: args.userId,
+          eventType: "user.deletion_requested",
+          payload: { postsMode: args.postsMode },
+        });
+
+        return {
+          outcome: "requested" as const,
+          purgeAt: addDays(now, graceDays),
+        };
+      });
+    },
+
+    /** Reactiva uma conta pendente (chamado depois de a palavra-passe ser validada). */
+    async restore(userId: string): Promise<RestoreResult> {
+      return db.transaction(async (tx) => {
+        const [row] = await tx
+          .select({ pending: users.deletionRequestedAt })
+          .from(users)
+          .where(eq(users.id, userId))
+          .for("update")
+          .limit(1);
+        if (!row) return "gone" as const;
+        if (!row.pending) return "already_active" as const;
+
+        await tx
+          .update(users)
+          .set({
+            deletionRequestedAt: null,
+            deletionPostsMode: null,
+            updatedAt: new Date(),
+          })
+          .where(eq(users.id, userId));
+        await tx
+          .update(posts)
+          .set({ status: sql`${posts.suspendedStatus}`, suspendedStatus: null })
+          .where(
+            and(eq(posts.authorId, userId), isNotNull(posts.suspendedStatus)),
+          );
+        await tx
+          .update(posts)
+          .set({ authorHidden: false })
+          .where(and(eq(posts.authorId, userId), eq(posts.authorHidden, true)));
+        await tx.insert(outbox).values({
+          aggregateType: "user",
+          aggregateId: userId,
+          eventType: "user.deletion_cancelled",
+          payload: {},
+        });
+        return "restored" as const;
+      });
+    },
+
+    /**
+     * Apaga de vez as contas pendentes há mais de `graceDays`. Uma transacção por conta: se
+     * uma falhar, as outras seguem. Seguro com várias instâncias em simultâneo (SKIP LOCKED).
+     */
+    async purgeDue(
+      opts: { now?: Date; graceDays?: number; batch?: number } = {},
+    ): Promise<PurgeSummary> {
+      const now = opts.now ?? new Date();
+      const graceDays = opts.graceDays ?? ACCOUNT_DELETION_GRACE_DAYS;
+      const cutoff = new Date(now.getTime() - graceDays * DAY_MS);
+
+      const due = await db
+        .select({ id: users.id })
+        .from(users)
+        .where(
+          and(
+            isNotNull(users.deletionRequestedAt),
+            lte(users.deletionRequestedAt, cutoff),
+          ),
+        )
+        .orderBy(users.deletionRequestedAt)
+        .limit(opts.batch ?? 50);
+
+      const summary: PurgeSummary = { accounts: 0, postsDeleted: 0, failed: 0 };
+      for (const { id } of due) {
+        try {
+          const result = await purgeOne(db, id, cutoff);
+          if (result) {
+            summary.accounts += 1;
+            summary.postsDeleted += result.postsDeleted;
+          }
+        } catch {
+          summary.failed += 1;
+        }
+      }
+      return summary;
+    },
+  };
+}
+
+async function purgeOne(
+  db: Database,
+  userId: string,
+  cutoff: Date,
+): Promise<{ postsDeleted: number } | null> {
+  return db.transaction(async (tx: Tx) => {
+    // Volta a verificar com a linha bloqueada: se entretanto a conta foi reactivada (ou outra
+    // instância a está a apagar), não se faz nada.
+    const [user] = await tx
+      .select({ mode: users.deletionPostsMode })
+      .from(users)
+      .where(
+        and(
+          eq(users.id, userId),
+          isNotNull(users.deletionRequestedAt),
+          lte(users.deletionRequestedAt, cutoff),
+        ),
+      )
+      .for("update", { skipLocked: true })
+      .limit(1);
+    if (!user) return null;
+
+    // Os likes e denúncias abertas desta conta desaparecem em cascata: acerta os contadores
+    // das partilhas dos outros ANTES de apagar. (user_id e reporter_id são únicos por post.)
+    await tx.execute(sql`
+      UPDATE posts p
+      SET likes_count = GREATEST(p.likes_count - 1, 0)
+      FROM post_likes l
+      WHERE l.post_id = p.id AND l.user_id = ${userId}
+    `);
+    await tx.execute(sql`
+      UPDATE posts p
+      SET reports_count = GREATEST(p.reports_count - 1, 0)
+      FROM reports r
+      WHERE r.post_id = p.id AND r.reporter_id = ${userId} AND r.status = 'open'
+    `);
+
+    let postsDeleted = 0;
+    if (user.mode === "delete") {
+      const removed = await tx
+        .delete(posts)
+        .where(eq(posts.authorId, userId))
+        .returning({ id: posts.id });
+      postsDeleted = removed.length;
+    }
+
+    // Cascata: sessões, idempotência, likes, denúncias, pedido de nova palavra-passe.
+    // author_id das partilhas «anónimas» passa a nulo; o log de moderação mantém-se.
+    await tx.delete(users).where(eq(users.id, userId));
+    return { postsDeleted };
+  });
+}
diff --git a/apps/api/src/routes/account.ts b/apps/api/src/routes/account.ts
new file mode 100644
index 0000000..81ab6d0
--- /dev/null
+++ b/apps/api/src/routes/account.ts
@@ -0,0 +1,86 @@
+import {
+  DeleteAccountRequest,
+  DeleteAccountResponse,
+  ErrorResponse,
+} from "@comunidade/shared";
+import type { FastifyInstance } from "fastify";
+import type { ZodTypeProvider } from "fastify-type-provider-zod";
+import type { JwtService } from "../auth/jwt.js";
+import { requireAuth } from "../auth/middleware.js";
+import type { PasswordService } from "../auth/password.js";
+import type { RateLimiters } from "../auth/rate-limit.js";
+import type { Database } from "../db/client.js";
+import type { Env } from "../env.js";
+import { accountDeletionRepo } from "../repositories/account-deletion.js";
+import { usersRepo } from "../repositories/users.js";
+
+export interface AccountRoutesOptions {
+  env: Env;
+  db: Database;
+  password: PasswordService;
+  jwt: JwtService;
+  limiters: RateLimiters;
+}
+
+export async function accountRoutes(
+  app: FastifyInstance,
+  { env, db, password, jwt, limiters }: AccountRoutesOptions,
+): Promise<void> {
+  const f = app.withTypeProvider<ZodTypeProvider>();
+  const users = usersRepo(db);
+  const deletion = accountDeletionRepo(db);
+
+  // Pede o apagamento da conta: fica pendente ACCOUNT_DELETION_GRACE_DAYS dias e um login
+  // com a palavra-passe correcta reactiva-a. POST (e não DELETE) porque leva corpo.
+  f.post(
+    "/users/me/deletion",
+    {
+      preHandler: requireAuth(jwt),
+      schema: {
+        body: DeleteAccountRequest,
+        response: {
+          200: DeleteAccountResponse,
+          401: ErrorResponse,
+          409: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const user = await users.findById(request.user!.id);
+      if (!user) return reply.code(401).send({ error: "invalid_token" });
+
+      // Mesmo limite do login: um access token roubado não pode servir para adivinhar a
+      // palavra-passe aqui.
+      const rl = await limiters.checkLogin(request.clientIp, user.username);
+      if (!rl.allowed) {
+        return reply
+          .code(429)
+          .header("Retry-After", String(rl.retryAfter ?? 60))
+          .send({ error: "rate_limited" });
+      }
+      const ok = await password.verifyPassword(
+        user.passwordHash,
+        request.body.password,
+      );
+      if (!ok) return reply.code(401).send({ error: "invalid_credentials" });
+      await limiters.loginSucceeded(request.clientIp, user.username);
+
+      const result = await deletion.request({
+        userId: user.id,
+        postsMode: request.body.postsMode,
+        graceDays: env.ACCOUNT_DELETION_GRACE_DAYS,
+      });
+      if (result.outcome === "not_found") {
+        return reply.code(401).send({ error: "invalid_token" });
+      }
+      if (result.outcome === "last_admin") {
+        return reply.code(409).send({ error: "last_admin" });
+      }
+      return reply.code(200).send({
+        status: "pending_deletion" as const,
+        purgeAt: result.purgeAt.toISOString(),
+      });
+    },
+  );
+}
