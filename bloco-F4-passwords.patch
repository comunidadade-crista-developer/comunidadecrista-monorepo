+  // Clássicas
+  "password", "passw0rd", "p@ssword", "p@ssw0rd", "pass1234", "password1", "password12",
+  "password123", "password1234", "senha", "senha123", "senha1234", "senhasecreta",
+  "palavrapasse", "palavra-passe", "palavrapasse123", "minhasenha", "minhasenha123",
+  "admin", "admin123", "administrador", "root", "toor", "letmein", "welcome", "welcome1",
+  "bemvindo", "bemvindo123", "login", "master", "dragon", "monkey", "shadow", "sunshine",
+  "princess", "football", "baseball", "superman", "batman", "iloveyou", "iloveyou1",
+  "trustno1", "abc123", "abc12345", "abcd1234", "abcdefgh", "abcdefg1", "qwerty",
+  "qwerty123", "qwertyui", "qwertyuiop", "qwerty12", "qwerty1234", "asdfghjk", "asdfghjkl",
+  "asdf1234", "zxcvbnm", "zxcvbnm1", "1qaz2wsx", "1q2w3e4r", "1q2w3e4r5t", "q1w2e3r4",
+  "q1w2e3r4t5", "zaq12wsx", "qazwsxedc", "azertyui", "azerty123",
+  // Números
+  "12345678", "123456789", "1234567890", "12345678910", "123456789012", "1234567890123", "0123456789", "987654321",
+  "9876543210", "87654321", "11111111", "111111111", "1111111111", "00000000", "000000000",
+  "22222222", "33333333", "44444444", "55555555", "66666666", "77777777", "88888888",
+  "99999999", "12121212", "11223344", "112233445566", "12341234", "123123123", "123321123",
+  "12344321", "13579246", "147258369", "159753456", "123456a", "123456789a", "a1234567",
+  "a12345678", "aa123456", "aaaaaaaa", "abcabcabc", "aaaa1111", "1234abcd",
+  // Português / Brasil / Portugal
+  "amorzinho", "meuamor", "meuamor123", "teamo", "teamo123", "teamomuito", "minhavida",
+  "meuanjo", "gatinha", "gatinho", "princesa", "princesa123", "querida", "bonita",
+  "linda123", "brasil", "brasil123", "portugal", "portugal123", "benfica", "benfica123",
+  "sporting", "sporting123", "fcporto", "porto123", "flamengo", "flamengo123",
+  "corinthians", "palmeiras", "saopaulo", "vasco123", "cristianoronaldo", "ronaldo7",
+  "cr7cr7cr7", "messi1234", "futebol", "futebol123", "mulher123", "familia", "familia123",
+  "amigos", "amigos123", "felicidade", "saudade", "saudades", "eusouavida",
+  "123mudar", "mudar123", "mudaragora", "trocar123", "teste123", "testando", "testando123",
+  // Moçambique / lusofonia africana
+  "mocambique", "mocambique123", "mozambique", "mozambique1", "maputo", "maputo123",
+  "matola", "matola123", "beira123", "nampula", "nampula123", "quelimane", "tete1234",
+  "pemba123", "xaixai", "chimoio", "lichinga", "inhambane", "angola", "angola123",
+  "luanda123", "caboverde", "guinebissau", "saotome", "timorleste", "africa123",
+  "frelimo", "frelimo123", "renamo", "eusoumocambicano", "mocambicano", "mocambicana",
+  // Fé e igreja
+  "jesus", "jesus123", "jesus1234", "jesuscristo", "jesuscristo1", "jesusteama",
+  "jesusteama1", "jesusamor", "jesuseamor", "jesusfiel", "jesusvive", "jesussalva",
