+/**
+ * Leitura pública com utilizador opcional: sem cabeçalho `Authorization` o pedido segue como
+ * anónimo; com cabeçalho, o token TEM de ser válido (senão 401). Assim o cliente com o token
+ * expirado renova-o em vez de receber, em silêncio, um feed sem os seus likes.
+ */
+export function optionalAuth(jwt: JwtService): preHandlerAsyncHookHandler {
+  return async (request, reply) => {
+    const auth = request.headers.authorization;
+    if (auth === undefined) return;
+    if (!auth.startsWith("Bearer ")) {
+      return reply.code(401).send({ error: "invalid_token" });
+    }
+    try {
+      const payload = await jwt.verifyAccessToken(auth.slice(7).trim());
+      request.user = { id: payload.sub, role: payload.role };
+    } catch {
+      return reply.code(401).send({ error: "invalid_token" });
+    }
+  };
+}
