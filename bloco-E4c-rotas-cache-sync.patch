diff --git a/apps/api/src/routes/posts.ts b/apps/api/src/routes/posts.ts
new file mode 100644
index 0000000..874decf
--- /dev/null
+++ b/apps/api/src/routes/posts.ts
@@ -0,0 +1,405 @@
+import {
+  CreatePostRequest,
+  CreatePostResponse,
+  ErrorResponse,
+  IdempotencyKey,
+  LikeResponse,
+  ListPostsQuery,
+  ListPostsResponse,
+  PostPublic,
+  PostIdParams,
+  ReportRequest,
+  ReportResponse,
+} from "@comunidade/shared";
+import type { FastifyInstance, FastifyReply } from "fastify";
+import type { ZodTypeProvider } from "fastify-type-provider-zod";
+import { z } from "zod";
+import type { JwtService } from "../auth/jwt.js";
+import { optionalAuth, requireAuth } from "../auth/middleware.js";
+import type { RateLimitResult, RateLimiters } from "../auth/rate-limit.js";
+import type { FeedCache } from "../cache/feed-cache.js";
+import type { Database } from "../db/client.js";
+import { InvalidCursorError, postsRepo } from "../repositories/posts.js";
+import { usersRepo } from "../repositories/users.js";
+import { decorateForViewer } from "../services/feed-view.js";
+import { presentOne, presentPosts } from "../services/post-presenter.js";
+import {
+  createPostService,
+  deletePostService,
+  likePostService,
+  reportPostService,
+  unlikePostService,
+  unreportPostService,
+  type ServiceError,
+} from "../services/posts.js";
+
+export interface PostsRoutesOptions {
+  db: Database;
+  jwt: JwtService;
+  limiters: RateLimiters;
+  feedCache: FeedCache;
+}
+
+const SinglePostResponse = z.object({ post: PostPublic });
+const DeleteResponse = z.object({ deleted: z.literal(true) });
+const UnreportResponse = z.object({ withdrawn: z.literal(true) });
+const CreateHeaders = z.object({ "idempotency-key": IdempotencyKey });
+
+/**
+ * Envia um erro no formato único. O `reply` das rotas tem tipos por código de resposta; aqui
+ * só interessa o formato `{ error }`, que o `ErrorResponse` de cada rota já declara.
+ */
+function sendError(
+  reply: object,
+  status: number,
+  error: string,
+  retryAfter?: number,
+): FastifyReply {
+  const r = (reply as FastifyReply).code(status);
+  if (retryAfter !== undefined) r.header("Retry-After", String(retryAfter));
+  return r.send({ error });
+}
+
+function tooMany(reply: object, rl: RateLimitResult): FastifyReply {
+  return sendError(reply, 429, "rate_limited", rl.retryAfter ?? 60);
+}
+
+function sendServiceError(reply: object, error: ServiceError): FastifyReply {
+  return sendError(reply, error.status, error.code);
+}
+
+export async function postsRoutes(
+  app: FastifyInstance,
+  { db, jwt, limiters, feedCache }: PostsRoutesOptions,
+): Promise<void> {
+  const f = app.withTypeProvider<ZodTypeProvider>();
+  const posts = postsRepo(db);
+  const users = usersRepo(db);
+  const deps = { db };
+  // `preValidation`: sem sessão válida o pedido é recusado (401) antes de se olhar para o corpo.
+  const authPre = requireAuth(jwt);
+  const maybeAuth = optionalAuth(jwt);
+
+  // ---------- Feed ----------
+
+  f.get(
+    "/posts",
+    {
+      preValidation: maybeAuth,
+      schema: {
+        querystring: ListPostsQuery,
+        response: {
+          200: ListPostsResponse,
+          400: ErrorResponse,
+          401: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const viewerId = request.user?.id;
+      const rl = await limiters.checkReadFeed(request.clientIp, viewerId);
+      if (!rl.allowed) return tooMany(reply, rl);
+
+      const { gospelCardId, category, filter, cursor, limit } = request.query;
+
+      try {
+        // «Curtidos por mim»: lista pessoal, nunca em cache; já vem decorada para o espectador.
+        if (filter === "liked") {
+          if (!viewerId) return sendError(reply, 401, "missing_token");
+          const result = await posts.list({
+            filter: "liked",
+            viewerId,
+            limit,
+            ...(gospelCardId ? { gospelCardId } : {}),
+            ...(category ? { category } : {}),
+            ...(cursor ? { cursor } : {}),
+          });
+          return reply.code(200).send({
+            posts: await presentPosts(result.items, db, viewerId),
+            nextCursor: result.nextCursor,
+          });
+        }
+
+        const page = await feedCache.list({
+          filter,
+          limit,
+          category,
+          gospelCardId,
+          cursor,
+        });
+
+        let items = await decorateForViewer(page, viewerId, db);
+
+        // O autor vê no topo a sua partilha em revisão (ainda não está no feed público). Só na
+        // primeira página: um post em revisão nunca aparece nas páginas públicas, por isso não
+        // há duplicados. Os publicados já vêm no próprio feed (criar invalida a cache).
+        if (viewerId && filter === "recent" && cursor === undefined) {
+          const pending = await posts.findLatestByAuthorInFilter(viewerId, {
+            statuses: ["pending_review"],
+            ...(gospelCardId ? { gospelCardId } : {}),
+            ...(category ? { category } : {}),
+          });
+          if (pending) {
+            items = [await presentOne(pending, db, viewerId), ...items];
+          }
+        }
+
+        return reply
+          .code(200)
+          .send({ posts: items, nextCursor: page.nextCursor });
+      } catch (err) {
+        // A rota já valida o cursor; isto é a rede de segurança.
+        if (err instanceof InvalidCursorError) {
+          return sendError(reply, 400, "validation_error");
+        }
+        throw err;
+      }
+    },
+  );
+
+  // ---------- Um post ----------
+
+  f.get(
+    "/posts/:id",
+    {
+      preValidation: maybeAuth,
+      schema: {
+        params: PostIdParams,
+        response: {
+          200: SinglePostResponse,
+          401: ErrorResponse,
+          404: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const viewer = request.user;
+      const rl = await limiters.checkReadFeed(request.clientIp, viewer?.id);
+      if (!rl.allowed) return tooMany(reply, rl);
+
+      // `findById` nunca devolve posts apagados pelo autor.
+      const post = await posts.findById(request.params.id);
+      if (!post) return sendError(reply, 404, "not_found");
+
+      if (post.status !== "published") {
+        // Estados não públicos: só o autor e os administradores. Para todos os outros o post
+        // «não existe» (404, nunca 403): não se confirma a existência.
+        let allowed = viewer !== undefined && post.authorId === viewer.id;
+        if (!allowed && viewer?.role === "admin") {
+          // O papel do JWT pode estar desactualizado: revalida-se na base de dados.
+          const user = await users.findById(viewer.id);
+          allowed =
+            user !== null &&
+            user.role === "admin" &&
+            user.deletedAt === null &&
+            user.deletionRequestedAt === null;
+        }
+        if (!allowed) return sendError(reply, 404, "not_found");
+      }
+
+      return reply
+        .code(200)
+        .send({ post: await presentOne(post, db, viewer?.id) });
+    },
+  );
+
+  // ---------- Criar ----------
+
+  f.post(
+    "/posts",
+    {
+      preValidation: authPre,
+      schema: {
+        headers: CreateHeaders,
+        body: CreatePostRequest,
+        response: {
+          200: CreatePostResponse,
+          201: CreatePostResponse,
+          400: ErrorResponse,
+          401: ErrorResponse,
+          403: ErrorResponse,
+          409: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const userId = request.user!.id;
+      const rl = await limiters.checkPostsCreate(userId);
+      if (!rl.allowed) return tooMany(reply, rl);
+
+      const result = await createPostService(
+        deps,
+        userId,
+        request.body,
+        request.headers["idempotency-key"],
+      );
+      if (!result.ok) return sendServiceError(reply, result.error);
+
+      const { replayed, ...body } = result.data;
+      // Um post em revisão não aparece no feed público: nada a invalidar. Repetição (mesma
+      // chave): nada foi criado agora.
+      if (!replayed && body.status === "published") {
+        await feedCache.invalidate();
+      }
+      return reply.code(replayed ? 200 : 201).send(body);
+    },
+  );
+
+  // ---------- Apagar ----------
+
+  f.delete(
+    "/posts/:id",
+    {
+      preValidation: authPre,
+      schema: {
+        params: PostIdParams,
+        response: {
+          200: DeleteResponse,
+          401: ErrorResponse,
+          403: ErrorResponse,
+          404: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const userId = request.user!.id;
+      const rl = await limiters.checkPostsDelete(userId);
+      if (!rl.allowed) return tooMany(reply, rl);
+
+      const result = await deletePostService(deps, userId, request.params.id);
+      if (!result.ok) return sendServiceError(reply, result.error);
+
+      if (result.data.changed) await feedCache.invalidate();
+      return reply.code(200).send({ deleted: true });
+    },
+  );
+
+  // ---------- Likes ----------
+
+  f.post(
+    "/posts/:id/like",
+    {
+      preValidation: authPre,
+      schema: {
+        params: PostIdParams,
+        response: {
+          200: LikeResponse,
+          401: ErrorResponse,
+          403: ErrorResponse,
+          404: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const userId = request.user!.id;
+      const rl = await limiters.checkLikes(userId);
+      if (!rl.allowed) return tooMany(reply, rl);
+
+      const result = await likePostService(deps, userId, request.params.id);
+      if (!result.ok) return sendServiceError(reply, result.error);
+
+      // Likes não invalidam o feed (D7): o contador público atrasa-se no máximo o TTL.
+      const { likesCount, isLiked } = result.data;
+      return reply.code(200).send({ likesCount, isLiked });
+    },
+  );
+
+  f.delete(
+    "/posts/:id/like",
+    {
+      preValidation: authPre,
+      schema: {
+        params: PostIdParams,
+        response: {
+          200: LikeResponse,
+          401: ErrorResponse,
+          403: ErrorResponse,
+          404: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const userId = request.user!.id;
+      const rl = await limiters.checkLikes(userId);
+      if (!rl.allowed) return tooMany(reply, rl);
+
+      const result = await unlikePostService(deps, userId, request.params.id);
+      if (!result.ok) return sendServiceError(reply, result.error);
+
+      const { likesCount, isLiked } = result.data;
+      return reply.code(200).send({ likesCount, isLiked });
+    },
+  );
+
+  // ---------- Denúncias ----------
+
+  f.post(
+    "/posts/:id/report",
+    {
+      preValidation: authPre,
+      schema: {
+        params: PostIdParams,
+        body: ReportRequest,
+        response: {
+          200: ReportResponse,
+          400: ErrorResponse,
+          401: ErrorResponse,
+          403: ErrorResponse,
+          404: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const userId = request.user!.id;
+      const rl = await limiters.checkReports(userId);
+      if (!rl.allowed) return tooMany(reply, rl);
+
+      const result = await reportPostService(
+        deps,
+        userId,
+        request.params.id,
+        request.body.category,
+        request.body.reason,
+      );
+      if (!result.ok) return sendServiceError(reply, result.error);
+
+      // Só quando esta denúncia fez o post sair do feed público (passou o limiar).
+      if (result.data.escalated) await feedCache.invalidate();
+      return reply.code(200).send({ outcome: result.data.outcome });
+    },
+  );
+
+  f.delete(
+    "/posts/:id/report",
+    {
+      preValidation: authPre,
+      schema: {
+        params: PostIdParams,
+        response: {
+          200: UnreportResponse,
+          401: ErrorResponse,
+          403: ErrorResponse,
+          404: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const userId = request.user!.id;
+      const rl = await limiters.checkReports(userId);
+      if (!rl.allowed) return tooMany(reply, rl);
+
+      const result = await unreportPostService(deps, userId, request.params.id);
+      if (!result.ok) return sendServiceError(reply, result.error);
+
+      return reply.code(200).send({ withdrawn: true });
+    },
+  );
+}
diff --git a/apps/api/src/routes/sync.ts b/apps/api/src/routes/sync.ts
new file mode 100644
index 0000000..2130dfb
--- /dev/null
+++ b/apps/api/src/routes/sync.ts
@@ -0,0 +1,363 @@
+import {
+  ErrorResponse,
+  SyncBootstrapResponse,
+  SyncRequest,
+  SyncResponse,
+} from "@comunidade/shared";
+import type {
+  SyncErrorCode,
+  SyncOperation,
+  SyncResult,
+} from "@comunidade/shared";
+import type { FastifyInstance, FastifyReply } from "fastify";
+import type { ZodTypeProvider } from "fastify-type-provider-zod";
+import type { JwtService } from "../auth/jwt.js";
+import { requireAuth } from "../auth/middleware.js";
+import type { RateLimitResult, RateLimiters } from "../auth/rate-limit.js";
+import type { CardsCache } from "../cache/cards-cache.js";
+import type { FeedCache } from "../cache/feed-cache.js";
+import type { Database } from "../db/client.js";
+import type { Env } from "../env.js";
+import { postLikesRepo, postsRepo } from "../repositories/posts.js";
+import { reportsRepo } from "../repositories/reports.js";
+import { usersRepo } from "../repositories/users.js";
+import { decorateForViewer } from "../services/feed-view.js";
+import { presentPosts } from "../services/post-presenter.js";
+import {
+  createPostService,
+  deletePostService,
+  likePostService,
+  reportPostService,
+  unlikePostService,
+  unreportPostService,
+} from "../services/posts.js";
+import type { ServiceError, ServiceResult } from "../services/posts.js";
+
+export interface SyncRoutesOptions {
+  env: Pick<Env, "SYNC_BATCH_TIMEOUT_MS">;
+  db: Database;
+  jwt: JwtService;
+  limiters: RateLimiters;
+  feedCache: FeedCache;
+  cardsCache: CardsCache;
+}
+
+/** Limites da lista de arranque; acima disto o cliente é avisado (`...Truncated`). */
+const BOOTSTRAP_MY_POSTS = 50;
+const BOOTSTRAP_MY_LIKES = 500;
+const BOOTSTRAP_MY_REPORTS = 100;
+const BOOTSTRAP_RECENT = 20;
+
+interface OpOutcome {
+  result: SyncResult;
+  invalidateFeed: boolean;
+}
+
+/** O serviço diz «não mudou nada» (`changed`/`replayed`): o cliente vê `duplicate`. */
+function done(
+  opId: string,
+  duplicate: boolean,
+  result: SyncResult["result"],
+  invalidateFeed = false,
+): OpOutcome {
+  return {
+    result: {
+      op_id: opId,
+      status: duplicate ? "duplicate" : "applied",
+      ...(result ? { result } : {}),
+    },
+    invalidateFeed: invalidateFeed && !duplicate,
+  };
+}
+
+function rejected(opId: string, code: SyncErrorCode): OpOutcome {
+  return {
+    result: { op_id: opId, status: "rejected", error: { code } },
+    invalidateFeed: false,
+  };
+}
+
+/** Fora do prazo ou limite: nada foi tentado, o cliente repete mais tarde. */
+function deferred(
+  opId: string,
+  error?: NonNullable<SyncResult["error"]>,
+): OpOutcome {
+  return {
+    result: {
+      op_id: opId,
+      status: "deferred",
+      ...(error ? { error } : {}),
+    },
+    invalidateFeed: false,
+  };
+}
+
+/**
+ * Códigos internos → contrato do `/sync`. Uma conta em apagamento vê `forbidden`.
+ * `reason_required` é inalcançável aqui (o schema do lote já exige o motivo para «other»).
+ */
+function toSyncCode(error: ServiceError): SyncErrorCode {
+  switch (error.code) {
+    case "not_found":
+    case "forbidden":
+    case "own_post":
+    case "idempotency_key_conflict":
+    case "gospel_card_not_found":
+    case "contains_link":
+    case "contains_contact":
+      return error.code;
+    case "account_inactive":
+      return "forbidden";
+    case "reason_required":
+      return "internal";
+  }
+}
+
+export async function syncRoutes(
+  app: FastifyInstance,
+  { env, db, jwt, limiters, feedCache, cardsCache }: SyncRoutesOptions,
+): Promise<void> {
+  const f = app.withTypeProvider<ZodTypeProvider>();
+  const authPre = requireAuth(jwt);
+  const deps = { db };
+
+  /**
+   * D5: cada operação paga os MESMOS limites do REST (partilham os baldes), além do limite
+   * do próprio lote. Sem isto, `/sync` seria uma porta lateral para contornar os limites.
+   */
+  function checkOpLimit(
+    userId: string,
+    op: SyncOperation,
+  ): Promise<RateLimitResult> {
+    switch (op.type) {
+      case "post.create":
+        return limiters.checkPostsCreate(userId);
+      case "post.delete":
+        return limiters.checkPostsDelete(userId);
+      case "post.like":
+      case "post.unlike":
+        return limiters.checkLikes(userId);
+      case "post.report":
+      case "post.unreport":
+        return limiters.checkReports(userId);
+    }
+  }
+
+  /** Mesmo tratamento de erro do `ServiceResult`: recusa definitiva com o código mapeado. */
+  function fromFailure(opId: string, r: ServiceResult<unknown>): OpOutcome {
+    return rejected(opId, r.ok ? "internal" : toSyncCode(r.error));
+  }
+
+  async function run(userId: string, op: SyncOperation): Promise<OpOutcome> {
+    switch (op.type) {
+      case "post.create": {
+        const r = await createPostService(
+          deps,
+          userId,
+          op.payload,
+          op.idempotency_key,
+        );
+        if (!r.ok) return fromFailure(op.op_id, r);
+        const { replayed, ...body } = r.data;
+        return done(op.op_id, replayed, body, body.status === "published");
+      }
+      case "post.delete": {
+        const r = await deletePostService(deps, userId, op.payload.postId);
+        if (!r.ok) return fromFailure(op.op_id, r);
+        return done(op.op_id, !r.data.changed, { deleted: true }, true);
+      }
+      case "post.like": {
+        const r = await likePostService(deps, userId, op.payload.postId);
+        if (!r.ok) return fromFailure(op.op_id, r);
+        const { likesCount, isLiked, changed } = r.data;
+        return done(op.op_id, !changed, { likesCount, isLiked });
+      }
+      case "post.unlike": {
+        const r = await unlikePostService(deps, userId, op.payload.postId);
+        if (!r.ok) return fromFailure(op.op_id, r);
+        const { likesCount, isLiked, changed } = r.data;
+        return done(op.op_id, !changed, { likesCount, isLiked });
+      }
+      case "post.report": {
+        const r = await reportPostService(
+          deps,
+          userId,
+          op.payload.postId,
+          op.payload.category,
+          op.payload.reason,
+        );
+        if (!r.ok) return fromFailure(op.op_id, r);
+        return done(
+          op.op_id,
+          !r.data.changed,
+          { outcome: r.data.outcome },
+          r.data.escalated,
+        );
+      }
+      case "post.unreport": {
+        const r = await unreportPostService(deps, userId, op.payload.postId);
+        if (!r.ok) return fromFailure(op.op_id, r);
+        return done(op.op_id, !r.data.changed, { withdrawn: true });
+      }
+    }
+  }
+
+  async function processOne(
+    userId: string,
+    op: SyncOperation,
+  ): Promise<OpOutcome> {
+    const rl = await checkOpLimit(userId, op);
+    if (!rl.allowed) {
+      return deferred(op.op_id, {
+        code: "rate_limited",
+        retryAfter: rl.retryAfter ?? 60,
+      });
+    }
+    try {
+      return await run(userId, op);
+    } catch (err) {
+      // Falha inesperada (ex.: base de dados): cada serviço é transaccional, por isso nada
+      // ficou a meio. Repetir é seguro (chave de idempotência / operações idempotentes), logo
+      // `deferred` e não `rejected`. Sem mensagem nem dados do utilizador nos logs.
+      app.log.error(
+        {
+          errorName: err instanceof Error ? err.name : typeof err,
+          errorCode:
+            typeof err === "object" &&
+            err !== null &&
+            "code" in err &&
+            typeof (err as { code: unknown }).code === "string"
+              ? (err as { code: string }).code
+              : undefined,
+          opType: op.type,
+        },
+        "sync: operation failed",
+      );
+      return deferred(op.op_id, { code: "internal" });
+    }
+  }
+
+  const sendError = (
+    reply: object,
+    status: number,
+    error: string,
+    retryAfter?: number,
+  ): FastifyReply => {
+    const r = (reply as FastifyReply).code(status);
+    if (retryAfter !== undefined) r.header("Retry-After", String(retryAfter));
+    return r.send({ error });
+  };
+
+  f.post(
+    "/sync",
+    {
+      preValidation: authPre,
+      schema: {
+        body: SyncRequest,
+        response: {
+          200: SyncResponse,
+          400: ErrorResponse,
+          401: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const userId = request.user!.id;
+      const rl = await limiters.checkSyncBatch(userId);
+      if (!rl.allowed) {
+        return sendError(reply, 429, "rate_limited", rl.retryAfter ?? 60);
+      }
+
+      const deadline = Date.now() + env.SYNC_BATCH_TIMEOUT_MS;
+      const results: SyncResult[] = [];
+      let invalidateFeed = false;
+
+      // Em série e pela ordem do cliente: uma operação pode depender da anterior.
+      for (const op of request.body.operations) {
+        if (Date.now() >= deadline) {
+          results.push(deferred(op.op_id).result);
+          continue;
+        }
+        const outcome = await processOne(userId, op);
+        results.push(outcome.result);
+        if (outcome.invalidateFeed) invalidateFeed = true;
+      }
+
+      // Uma só invalidação por lote.
+      if (invalidateFeed) await feedCache.invalidate();
+
+      return reply
+        .code(200)
+        .send({ results, serverTime: new Date().toISOString() });
+    },
+  );
+
+  f.get(
+    "/sync/bootstrap",
+    {
+      preValidation: authPre,
+      schema: {
+        response: {
+          200: SyncBootstrapResponse,
+          401: ErrorResponse,
+          403: ErrorResponse,
+          429: ErrorResponse,
+        },
+      },
+    },
+    async (request, reply) => {
+      const userId = request.user!.id;
+      const rl = await limiters.checkSyncBatch(userId);
+      if (!rl.allowed) {
+        return sendError(reply, 429, "rate_limited", rl.retryAfter ?? 60);
+      }
+
+      const user = await usersRepo(db).findById(userId);
+      if (!user) return sendError(reply, 401, "invalid_token");
+      if (user.deletionRequestedAt) {
+        return sendError(reply, 403, "account_inactive");
+      }
+
+      // Pede-se um a mais do que o limite para saber se houve corte.
+      const [cards, recent, myPostRows, liked, myReportRows] =
+        await Promise.all([
+          cardsCache.list(),
+          feedCache.list({ filter: "recent", limit: BOOTSTRAP_RECENT }),
+          postsRepo(db).listByAuthor(userId, BOOTSTRAP_MY_POSTS + 1),
+          postLikesRepo(db).listLikedPostIds(userId, BOOTSTRAP_MY_LIKES),
+          reportsRepo(db).listByReporter(userId, BOOTSTRAP_MY_REPORTS + 1),
+        ]);
+
+      const [recentPosts, myPosts] = await Promise.all([
+        decorateForViewer(recent, userId, db),
+        presentPosts(myPostRows.slice(0, BOOTSTRAP_MY_POSTS), db, userId),
+      ]);
+
+      return reply.code(200).send({
+        serverTime: new Date().toISOString(),
+        user: {
+          id: user.id,
+          username: user.username,
+          role: user.role,
+          createdAt: user.createdAt.toISOString(),
+        },
+        cards,
+        recentPosts: { posts: recentPosts, nextCursor: recent.nextCursor },
+        myPosts,
+        myPostsTruncated: myPostRows.length > BOOTSTRAP_MY_POSTS,
+        myLikedPostIds: liked.ids,
+        myLikedPostIdsTruncated: liked.truncated,
+        myReports: myReportRows.slice(0, BOOTSTRAP_MY_REPORTS).map((r) => ({
+          id: r.id,
+          postId: r.postId,
+          category: r.category,
+          reason: r.reason,
+          status: r.status,
+          createdAt: r.createdAt.toISOString(),
+        })),
+        myReportsTruncated: myReportRows.length > BOOTSTRAP_MY_REPORTS,
+      });
+    },
+  );
+}
