diff --git a/apps/api/test/http-errors.test.ts b/apps/api/test/http-errors.test.ts
new file mode 100644
index 0000000..32da229
--- /dev/null
+++ b/apps/api/test/http-errors.test.ts
@@ -0,0 +1,206 @@
+import { describe, expect, it } from "vitest";
+import {
+  collectFields,
+  errorHandler,
+  notFoundHandler,
+  statusOf,
+} from "../src/http-errors.js";
+
+describe("statusOf", () => {
+  it("usa statusCode/status válidos (400–599), senão 500", () => {
+    expect(statusOf({ statusCode: 404 })).toBe(404);
+    expect(statusOf({ status: 429 })).toBe(429);
+    expect(statusOf({ statusCode: 200 })).toBe(500);
+    expect(statusOf({ statusCode: "400" })).toBe(500);
+    expect(statusOf(new Error("x"))).toBe(500);
+    expect(statusOf(null)).toBe(500);
+    expect(statusOf("erro")).toBe(500);
+  });
+});
+
+describe("collectFields", () => {
+  it("lê issues (ZodError): primeira mensagem por campo, path com ponto", () => {
+    const fields = collectFields({
+      issues: [
+        { path: ["username"], message: "curto" },
+        { path: ["username"], message: "segunda (ignorada)" },
+        { path: ["a", 0, "b"], message: "aninhado" },
+        { path: [], message: "raiz" },
+      ],
+    });
+    expect(fields).toEqual({
+      username: "curto",
+      "a.0.b": "aninhado",
+      _: "raiz",
+    });
+  });
+
+  it("lê validation (estilo Ajv) pela instancePath", () => {
+    const fields = collectFields({
+      validation: [
+        { instancePath: "/password", message: "curta" },
+        { instancePath: "/user/name", message: "obrigatório" },
+      ],
+    });
+    expect(fields).toEqual({ password: "curta", "user.name": "obrigatório" });
+  });
+
+  it("prefere params.issue quando existe", () => {
+    const fields = collectFields({
+      validation: [
+        {
+          instancePath: "/x",
+          message: "genérica",
+          params: { issue: { path: ["passwordConfirmation"], message: "não coincidem" } },
+        },
+      ],
+    });
+    expect(fields).toEqual({ passwordConfirmation: "não coincidem" });
+  });
+
+  it("limita número de campos e tamanho das mensagens", () => {
+    const issues = Array.from({ length: 50 }, (_, i) => ({
+      path: [`f${i}`],
+      message: "m".repeat(500),
+    }));
+    const fields = collectFields({ issues });
+    expect(Object.keys(fields)).toHaveLength(20);
+    expect(Object.values(fields).every((m) => m.length === 200)).toBe(true);
+  });
+
+  it("não rebenta com lixo", () => {
+    expect(collectFields(null)).toEqual({});
+    expect(collectFields({ issues: [null, 1, "x"] })).toEqual({});
+    expect(collectFields({ validation: "x" })).toEqual({});
+  });
+});
+
+// Reply/Request mínimos: o que interessa é o código HTTP, o corpo e o que se regista.
+function fakeReply() {
+  const out: { status?: number; body?: unknown } = {};
+  const reply = {
+    code(status: number) {
+      out.status = status;
+      return reply;
+    },
+    send(payload: unknown) {
+      out.body = payload;
+      return reply;
+    },
+  };
+  return { reply, out };
+}
+
+function fakeRequest() {
+  const logged: Array<{ obj: Record<string, unknown>; msg: string }> = [];
+  const request = {
+    method: "POST",
+    routeOptions: { url: "/posts/:id" },
+    log: {
+      error(obj: Record<string, unknown>, msg: string) {
+        logged.push({ obj, msg });
+      },
+    },
+  };
+  return { request, logged };
+}
+
+describe("errorHandler", () => {
+  it("5xx: corpo genérico e log sem mensagem nem valores", () => {
+    const { reply, out } = fakeReply();
+    const { request, logged } = fakeRequest();
+    const err = Object.assign(
+      new Error('duplicate key: Key (username)=(SEGREDO) already exists'),
+      { code: "23505", detail: "Key (username)=(SEGREDO)" },
+    );
+
+    errorHandler(err, request as never, reply as never);
+
+    expect(out.status).toBe(500);
+    expect(out.body).toEqual({ error: "internal_error" });
+    expect(logged).toHaveLength(1);
+    const serialized = JSON.stringify(logged[0]);
+    expect(serialized).not.toContain("SEGREDO");
+    expect(serialized).not.toContain("duplicate key");
+    expect(logged[0]!.obj.errorName).toBe("Error");
+    expect(logged[0]!.obj.errorCode).toBe("23505");
+    expect(logged[0]!.obj.route).toBe("/posts/:id");
+  });
+
+  it("503 → service_unavailable", () => {
+    const { reply, out } = fakeReply();
+    errorHandler({ statusCode: 503 }, fakeRequest().request as never, reply as never);
+    expect(out.status).toBe(503);
+    expect(out.body).toEqual({ error: "service_unavailable" });
+  });
+
+  it("valor lançado que não é Error também dá 500 genérico", () => {
+    const { reply, out } = fakeReply();
+    const { request } = fakeRequest();
+    errorHandler("texto com SEGREDO", request as never, reply as never);
+    expect(out.status).toBe(500);
+    expect(out.body).toEqual({ error: "internal_error" });
+  });
+
+  it.each([
+    [400, "bad_request"],
+    [401, "unauthorized"],
+    [403, "forbidden"],
+    [404, "not_found"],
+    [413, "payload_too_large"],
+    [415, "unsupported_media_type"],
+    [429, "rate_limited"],
+    [418, "bad_request"],
+  ])("4xx %i → %s, sem repetir a mensagem original", (status, code) => {
+    const { reply, out } = fakeReply();
+    const { request, logged } = fakeRequest();
+    errorHandler(
+      Object.assign(new Error("detalhe interno SEGREDO"), { statusCode: status }),
+      request as never,
+      reply as never,
+    );
+    expect(out.status).toBe(status);
+    expect(out.body).toEqual({ error: code });
+    expect(logged).toHaveLength(0);
+  });
+
+  it("validação → 400 validation_error com fields", () => {
+    const { reply, out } = fakeReply();
+    errorHandler(
+      Object.assign(new Error("body invalid"), {
+        statusCode: 400,
+        code: "FST_ERR_VALIDATION",
+        issues: [{ path: ["username"], message: "curto" }],
+      }),
+      fakeRequest().request as never,
+      reply as never,
+    );
+    expect(out.status).toBe(400);
+    expect(out.body).toEqual({
+      error: "validation_error",
+      fields: { username: "curto" },
+    });
+  });
+
+  it("validação sem campos extraíveis → validation_error sem fields", () => {
+    const { reply, out } = fakeReply();
+    errorHandler(
+      Object.assign(new Error("x"), {
+        statusCode: 400,
+        code: "FST_ERR_VALIDATION",
+      }),
+      fakeRequest().request as never,
+      reply as never,
+    );
+    expect(out.body).toEqual({ error: "validation_error" });
+  });
+});
+
+describe("notFoundHandler", () => {
+  it("404 not_found", () => {
+    const { reply, out } = fakeReply();
+    notFoundHandler(fakeRequest().request as never, reply as never);
+    expect(out.status).toBe(404);
+    expect(out.body).toEqual({ error: "not_found" });
+  });
+});
diff --git a/apps/api/test/routes/errors.handler.test.ts b/apps/api/test/routes/errors.handler.test.ts
new file mode 100644
index 0000000..f48ed0e
--- /dev/null
+++ b/apps/api/test/routes/errors.handler.test.ts
@@ -0,0 +1,176 @@
+import { LoginRequest } from "@comunidade/shared";
+import type { ZodTypeProvider } from "fastify-type-provider-zod";
+import { Writable } from "node:stream";
+import request from "supertest";
+import { afterAll, describe, expect, it } from "vitest";
+import { loadEnv } from "../../src/env.js";
+import { buildServer } from "../../src/server.js";
+import { closeTestDb } from "../helpers/db.js";
+
+afterAll(async () => {
+  await closeTestDb();
+});
+
+// O .env local também é lido: fixar o que interessa a estes testes.
+async function makeApp(logStream?: NodeJS.WritableStream) {
+  const env = loadEnv({
+    NODE_ENV: "test",
+    LOG_LEVEL: "error",
+    APP_VERSION: "test",
+    EDGE_MODE: "none",
+    CF_ORIGIN_SECRET: undefined,
+    CF_ORIGIN_SECRET_PREVIOUS: undefined,
+    IP_HASH_SECRET: "segredo-hmac-do-rate-limit-com-32-caracteres",
+  });
+  const app = await buildServer({ env, ...(logStream ? { logStream } : {}) });
+  app.get("/__test__/boom", async () => {
+    throw new Error("postgres://utilizador:SEGREDO_NO_ERRO@host/db");
+  });
+  app.get("/__test__/boom-500", async () => {
+    throw Object.assign(new Error("SEGREDO_NO_ERRO"), { statusCode: 500 });
+  });
+  app.get("/__test__/forbidden", async () => {
+    throw Object.assign(new Error("SEGREDO_NO_ERRO"), { statusCode: 403 });
+  });
+  app.post("/__test__/echo", async (req) => ({ ok: true, body: req.body }));
+  app
+    .withTypeProvider<ZodTypeProvider>()
+    .post(
+      "/__test__/validate",
+      { schema: { body: LoginRequest } },
+      async () => ({ ok: true }),
+    );
+  await app.ready();
+  return app;
+}
+
+describe("formato único de erro", () => {
+  it("rota desconhecida → 404 { error: not_found }", async () => {
+    const app = await makeApp();
+    try {
+      const res = await request(app.server).get("/nao-existe");
+      expect(res.status).toBe(404);
+      expect(res.body).toEqual({ error: "not_found" });
+    } finally {
+      await app.close();
+    }
+  });
+
+  it("erro interno → 500 genérico; nem a resposta nem os logs levam a mensagem", async () => {
+    const lines: string[] = [];
+    const stream = new Writable({
+      write(chunk, _enc, cb) {
+        lines.push(chunk.toString());
+        cb();
+      },
+    });
+    const app = await makeApp(stream);
+    try {
+      const res = await request(app.server).get("/__test__/boom");
+      expect(res.status).toBe(500);
+      expect(res.body).toEqual({ error: "internal_error" });
+      expect(JSON.stringify(res.body)).not.toContain("SEGREDO_NO_ERRO");
+    } finally {
+      await app.close();
+    }
+    const logs = lines.join("\n");
+    expect(logs).toContain("unhandled error");
+    expect(logs).not.toContain("SEGREDO_NO_ERRO");
+  });
+
+  it("erro com statusCode 500 explícito também é genérico", async () => {
+    const app = await makeApp();
+    try {
+      const res = await request(app.server).get("/__test__/boom-500");
+      expect(res.status).toBe(500);
+      expect(res.body).toEqual({ error: "internal_error" });
+    } finally {
+      await app.close();
+    }
+  });
+
+  it("4xx lançado no código não repete a mensagem", async () => {
+    const app = await makeApp();
+    try {
+      const res = await request(app.server).get("/__test__/forbidden");
+      expect(res.status).toBe(403);
+      expect(res.body).toEqual({ error: "forbidden" });
+    } finally {
+      await app.close();
+    }
+  });
+
+  it("JSON inválido → 400 bad_request", async () => {
+    const app = await makeApp();
+    try {
+      const res = await request(app.server)
+        .post("/__test__/echo")
+        .set("Content-Type", "application/json")
+        .send("{");
+      expect(res.status).toBe(400);
+      expect(res.body).toEqual({ error: "bad_request" });
+    } finally {
+      await app.close();
+    }
+  });
+
+  it("content-type não suportado → 415", async () => {
+    const app = await makeApp();
+    try {
+      const res = await request(app.server)
+        .post("/__test__/echo")
+        .set("Content-Type", "text/plain")
+        .send("olá");
+      expect(res.status).toBe(415);
+      expect(res.body).toEqual({ error: "unsupported_media_type" });
+    } finally {
+      await app.close();
+    }
+  });
+
+  it("corpo acima do limite → 413", async () => {
+    const app = await makeApp();
+    try {
+      const res = await request(app.server)
+        .post("/__test__/echo")
+        .set("Content-Type", "application/json")
+        .send(JSON.stringify({ a: "x".repeat(1_200_000) }));
+      expect(res.status).toBe(413);
+      expect(res.body).toEqual({ error: "payload_too_large" });
+    } finally {
+      await app.close();
+    }
+  });
+
+  // Depende da forma do erro que o type provider do zod produz.
+  it("validação → 400 validation_error com fields por campo", async () => {
+    const app = await makeApp();
+    try {
+      const res = await request(app.server)
+        .post("/__test__/validate")
+        .send({ username: "a", password: "x" });
+      expect(res.status).toBe(400);
+      expect(res.body.error).toBe("validation_error");
+      expect(Object.keys(res.body.fields ?? {})).toEqual(
+        expect.arrayContaining(["username", "password"]),
+      );
+    } finally {
+      await app.close();
+    }
+  });
+
+  it("rate limit global → 429 { error: rate_limited } com Retry-After", async () => {
+    const app = await makeApp();
+    try {
+      let last = await request(app.server).get("/health");
+      for (let i = 0; i < 100; i++) {
+        last = await request(app.server).get("/health");
+      }
+      expect(last.status).toBe(429);
+      expect(last.body).toEqual({ error: "rate_limited" });
+      expect(last.headers["retry-after"]).toBeDefined();
+    } finally {
+      await app.close();
+    }
+  });
+});
diff --git a/packages/shared/src/auth.ts b/packages/shared/src/auth.ts
