diff --git a/apps/api/drizzle/0005_admin_moderation_actions.sql b/apps/api/drizzle/0005_admin_moderation_actions.sql
new file mode 100644
index 0000000..4637bf3
--- /dev/null
+++ b/apps/api/drizzle/0005_admin_moderation_actions.sql
@@ -0,0 +1,6 @@
+-- E6: acções de administração no registo de auditoria (ADR-015).
+--
+-- Fica sozinha numa migração: `ADD VALUE` corre dentro da transacção do migrador e o valor
+-- novo não pode ser usado na mesma transacção (Postgres ≥ 12 permite o `ADD VALUE`, não o uso).
+ALTER TYPE "public"."moderation_action" ADD VALUE 'admin.promoted';--> statement-breakpoint
+ALTER TYPE "public"."moderation_action" ADD VALUE 'admin.demoted';
diff --git a/apps/api/drizzle/0006_moderation_target_user_indexes.sql b/apps/api/drizzle/0006_moderation_target_user_indexes.sql
new file mode 100644
index 0000000..e18ded0
--- /dev/null
+++ b/apps/api/drizzle/0006_moderation_target_user_indexes.sql
@@ -0,0 +1,5 @@
+-- E6: utilizador afectado nas acções de administração e índices das listagens do painel admin.
+ALTER TABLE "moderation_log" ADD COLUMN "target_user_id" uuid;--> statement-breakpoint
+ALTER TABLE "moderation_log" ADD CONSTRAINT "moderation_log_target_user_id_users_id_fk" FOREIGN KEY ("target_user_id") REFERENCES "public"."users"("id") ON DELETE set null ON UPDATE no action;--> statement-breakpoint
+CREATE INDEX "moderation_log_created_idx" ON "moderation_log" USING btree ("created_at","id");--> statement-breakpoint
+CREATE INDEX "reports_status_created_idx" ON "reports" USING btree ("status","created_at","id");
