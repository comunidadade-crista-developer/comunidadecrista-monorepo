+      params: ["SEGREDO"],
+      cause: Object.assign(new Error("Key (username)=(SEGREDO)"), {
+        name: "DatabaseError",
+        code: "23505",
+      }),
+    });
+    const out = safeErrorFields(err);
+    expect(out).toEqual({
+      errorName: "Error",
+      errorCode: "23505",
+      causeName: "DatabaseError",
+    });
+    expect(JSON.stringify(out)).not.toContain("SEGREDO");
+  });
+
+  it("valores que não são erros", () => {
