+    const a: Record<string, unknown> = {};
+    a.cause = a;
+    expect(pgErrorCode(a)).toBeUndefined();
+    let deep: Record<string, unknown> = { code: "23505" };
+    for (let i = 0; i < 10; i++) deep = { cause: deep };
+    expect(pgErrorCode(deep)).toBeUndefined();
+  });
+});
+
