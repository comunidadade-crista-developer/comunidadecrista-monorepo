+++ b/packages/shared/src/reserved-usernames.ts
@@ -0,0 +1,117 @@
+/**
+ * Nomes de utilizador reservados (registo e futura alteração de username).
+ * Impedem a personificação da equipa («admin», «moderador», «suporte»...) e colisões com
+ * textos do sistema («removido»). O login NÃO aplica esta regra: contas existentes com estes
+ * nomes (por exemplo um administrador criado à mão) continuam a entrar.
+ *
+ * A comparação é feita sobre uma forma normalizada, não sobre o texto literal, para apanhar
+ * variantes como «Admin», «ad.min», «a_d-m_i-n», «4dm1n», «admin2024», «admin-oficial».
+ * Nunca se procura a palavra DENTRO de outra («badminton», «admiral» e «modesto» passam).
+ */
+
+// Minúsculas, sem acentos, sem separadores. Aumenta-se por PR.
+const RESERVED: ReadonlySet<string> = new Set([
+  // Equipa e papéis
+  "admin", "adm", "administrador", "administradora", "administrator", "administracao",
+  "sysadmin", "superadmin", "superuser", "root", "owner", "dono",
+  "moderador", "moderadora", "moderator", "mod", "mods", "moderacao", "moderation",
+  "suporte", "support", "helpdesk", "ajuda", "help", "staff", "equipa", "team",
+  "oficial", "official", "sistema", "system", "bot",
+  // Contacto e infra-estrutura habitual
+  "contacto", "contato", "contact", "info", "security", "seguranca", "abuse", "postmaster",
+  "webmaster", "hostmaster", "noreply", "naoresponder", "api", "www", "app", "login",
+  "logout", "register", "registo", "auth", "me", "eu",
+  // Valores que confundem código, interface ou outros utilizadores
+  "null", "undefined", "none", "nan", "anonymous", "anonimo", "anonima", "removido",
+  "removida", "apagado", "apagada", "deleted", "removed", "unknown", "desconhecido",
+  // Marca
+  "comunidade", "comunidadecrista", "comunidadecristao", "gekkodreamers",
+]);
+
+// Prefixos/sufixos que não mudam a quem o nome «se parece»: «admin-oficial», «theadmin».
+const AFFIXES: readonly string[] = [
+  "oficial", "official", "the", "real", "equipa", "team", "app",
+];
+
+// Com afixo só contam as palavras reservadas com 5+ letras: evita que «dome» ou «teamo»
+// caiam por causa de «me»/«mo» e mantém «theadmin», «suporte-oficial», «moderador.team».
+const MIN_RESERVED_LENGTH_WITH_AFFIX = 5;
+
+// «Leetspeak» (4dm1n). O «1» é ambíguo (i ou l), por isso gera-se uma variante para cada.
+const LEET: Readonly<Record<string, string>> = {
+  "0": "o",
+  "3": "e",
+  "4": "a",
+  "5": "s",
+  "7": "t",
+  "8": "b",
+};
+
+function stripAccents(value: string): string {
+  return value.normalize("NFKD").replace(/[̀-ͯ]/g, "");
+}
+
+/** Só letras e dígitos, minúsculas (remove `.`, `_` e `-`). */
+function squash(value: string): string {
+  return stripAccents(value)
+    .toLowerCase()
+    .replace(/[^a-z0-9]/g, "");
+}
+
+function stripEdgeDigits(value: string): string {
+  return value.replace(/^\d+/, "").replace(/\d+$/, "");
+}
+
+function leet(value: string, one: "i" | "l"): string {
+  let out = "";
+  for (const ch of value) {
+    out += ch === "1" ? one : (LEET[ch] ?? ch);
+  }
+  return out;
+}
+
+function candidates(username: string): Set<string> {
+  const base = squash(username);
+  const forms = [
+    base,
+    leet(base, "i"),
+    leet(base, "l"),
+  ];
+  const out = new Set<string>();
+  for (const form of forms) {
+    // Com dígitos nas pontas («admin2024») e sem eles («4dm1n» já foi convertido acima).
+    out.add(form);
+    out.add(stripEdgeDigits(form));
+  }
+  out.delete("");
+  return out;
+}
+
+function matchesReserved(form: string): boolean {
+  if (RESERVED.has(form)) return true;
+  const isReservedWithAffix = (rest: string): boolean => {
+    const core = stripEdgeDigits(rest);
+    return core.length >= MIN_RESERVED_LENGTH_WITH_AFFIX && RESERVED.has(core);
+  };
+  for (const affix of AFFIXES) {
+    if (form.length > affix.length && form.startsWith(affix)) {
+      if (isReservedWithAffix(form.slice(affix.length))) return true;
+    }
+    if (form.length > affix.length && form.endsWith(affix)) {
+      if (isReservedWithAffix(form.slice(0, -affix.length))) return true;
+    }
+  }
+  return false;
+}
+
+/** `true` se o nome (ou uma variante óbvia dele) está reservado. */
+export function isReservedUsername(username: string): boolean {
+  for (const form of candidates(username)) {
+    if (matchesReserved(form)) return true;
+  }
+  return false;
+}
+
+// Mensagem genérica de propósito: não revela a lista nem porque é que foi recusado.
+export const RESERVED_USERNAME_MESSAGE =
+  "este nome de utilizador não está disponível";
