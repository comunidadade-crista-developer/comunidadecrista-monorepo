diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 1166e3a..f43b109 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -78,6 +78,18 @@ jobs:
       - name: Typecheck
         run: pnpm typecheck
 
+      # As migrações têm de estar em sincronia com o schema: `check` valida a cadeia de snapshots
+      # e `generate` não pode produzir nada (se produzir, alguém alterou o schema sem migração).
+      - name: Migrações em sincronia com o schema
+        run: |
+          pnpm --filter @comunidade/api exec drizzle-kit check
+          pnpm --filter @comunidade/api exec drizzle-kit generate --name=ci_drift
+          if [ -n "$(git status --porcelain)" ]; then
+            echo "::error::O schema difere das migrações. Corre 'pnpm --filter @comunidade/api db:generate' e faz commit."
+            git status --porcelain
+            exit 1
+          fi
+
       - name: Test
         run: pnpm test:ci
 
diff --git a/apps/api/.env.example b/apps/api/.env.example
index 120790c..887ba82 100644
--- a/apps/api/.env.example
+++ b/apps/api/.env.example
@@ -66,6 +66,8 @@ RATE_LIMIT_GLOBAL_MAX=300
 RATE_LIMIT_GLOBAL_WINDOW_S=60
 BODY_LIMIT_BYTES=524288
 REQUEST_TIMEOUT_MS=30000
+# Segundos em que o reenvio de um refresh token acabado de rotacionar é tolerado (0 desliga).
+REFRESH_REUSE_GRACE_S=10
 RATE_LIMIT_CARDS_MAX=120
 RATE_LIMIT_CARDS_WINDOW_S=60
 # Leitura do feed (por utilizador autenticado; por IP para anónimos)
diff --git a/apps/api/drizzle/0007_refresh_rotated_at.sql b/apps/api/drizzle/0007_refresh_rotated_at.sql
new file mode 100644
index 0000000..a01d79e
--- /dev/null
+++ b/apps/api/drizzle/0007_refresh_rotated_at.sql
@@ -0,0 +1,4 @@
+-- RB-b: momento em que um refresh token foi substituído por rotação. Distingue-o de um token
+-- revogado por logout ou por mudança de palavra-passe (`revoked_at` sozinho não distingue) e
+-- permite tolerar, durante poucos segundos, o reenvio do token antigo (vários separadores, retry).
+ALTER TABLE "refresh_tokens" ADD COLUMN "rotated_at" timestamp with time zone;
